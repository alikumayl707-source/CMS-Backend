generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  module    String
  entity    String?
  entityId  String?
  ipAddress String?
  userAgent String?
  statusCode Int?
  success Boolean @default(true)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("audit_logs")
}

model RoleCondition {
  id        Int    @id @default(autoincrement())
  roleId    Int
  target    String
  attribute String
  operator  String
  value     Json
  role      Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([roleId])
  @@map("role_conditions")
}

model AccessSimulation {
  id            Int      @id @default(autoincrement())
  userId        Int
  permissionKey String
  resource      Json
  allowed       Boolean
  reason        String?
  simulatedAt   DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("accesssimulation")
}

model ClaimApprovalHistory {
  id Int @id @default(autoincrement())

  claimApprovalId Int
  actorId         Int

  action   String
  comments String?

  createdAt DateTime @default(now())

  claimApproval ClaimApproval @relation(fields: [claimApprovalId], references: [id], onDelete: Cascade)

  actor User @relation(fields: [actorId], references: [id])

  @@index([claimApprovalId])
  @@index([actorId])
}

model Notification {
  id Int @id @default(autoincrement())

  userId  Int
  title   String
  message String

  channel String // IN_APP, EMAIL

  isRead Boolean @default(false)

  sentAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

enum ClaimStatus {
  DRAFT

  PENDING_REVIEW

  SUBMITTED

  PENDING_APPROVAL

  PARTIALLY_APPROVED

  APPROVED

  REJECTED

  RETURNED

  CANCELLED
}

model ClaimApproval {
  id Int @id @default(autoincrement())

  claimId  Int
  sequence Int

  roleId     Int?
  approverId Int?

  status String?

  actionedAt DateTime?
  comments   String?

  isParallel Boolean @default(false)
  groupKey   String?

  escalatedAt    DateTime?
  dueAt          DateTime?
  reminderSentAt DateTime?
 createdAt      DateTime  @default(now()) 
  claim Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  role Role? @relation(fields: [roleId], references: [id])

  approver User? @relation("ClaimApprovalActor", fields: [approverId], references: [id])

  approvalHistory ClaimApprovalHistory[]

@@unique([claimId, sequence])
  @@index([claimId])
  @@index([roleId])
  @@index([approverId])
  @@map("claimapproval")
}

model Department {
  id            Int          @id @default(autoincrement())
  name          String       @unique

  parentId      Int?
  parent        Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children      Department[] @relation("DepartmentHierarchy")

  isHRDept      Boolean @default(false)
  isFinanceDept Boolean @default(false)

  users            User[]
  claims           Claim[]
  approvalMatrices ApprovalMatrix[]
}

model Claim {
  id Int @id @default(autoincrement())

  claimNumber  String?   @unique
  policyNumber String?
  customerId   Int?
  incidentDate DateTime?
  formData     Json?
  amount       Decimal

  requiredApproverRole    String?
  status                  String?
  currentApprovalSequence Int?
  systemStage             String? // NEW: null | "HR" | "FINANCE" | "DONE"

  approvals ClaimApproval[]

  claimTypeId Int?
  claimType   ClaimType? @relation(fields: [claimTypeId], references: [id])

  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id])

  assignedApproverId Int?
  assignedApprover   User? @relation("ClaimAssignedApprover", fields: [assignedApproverId], references: [id])

  dedupeHash         String?
  isDuplicateSuspect Boolean @default(false)
  duplicateOfId      Int?
  duplicateOf        Claim?  @relation("ClaimDuplicate", fields: [duplicateOfId], references: [id])
  duplicatesOfThis   Claim[] @relation("ClaimDuplicate")

  rejectedBy        Int?
  rejectionComments String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  submittedAt DateTime?

  createdBy  Int
  reviewedBy Int?
  approvedBy Int?

  creator  User  @relation("ClaimCreator", fields: [createdBy], references: [id])
  reviewer User? @relation("ClaimReviewer", fields: [reviewedBy], references: [id])
  approver User? @relation("ClaimApprover", fields: [approvedBy], references: [id])
  approvalMatrixId Int?
  approvalMatrix   ApprovalMatrix? @relation(fields: [approvalMatrixId], references: [id])

  documents      ClaimDocument[]
  investigations ClaimInvestigation[]
  reminderSentAt      DateTime?   
  escalatedAt         DateTime?   
  claimantNotifiedAt  DateTime?
  @@index([claimTypeId])
  @@index([departmentId])
  @@index([assignedApproverId])
  @@index([dedupeHash])
}

model ApprovalMatrix {

  id Int @id @default(autoincrement())

  workflowName String?

  version Int @default(1)

  status WorkflowStatus @default(DRAFT)

  isActive Boolean @default(true)

  claimType String

  departmentId Int?

  department Department? @relation(fields: [departmentId], references: [id])

  minAmount Decimal

  maxAmount Decimal

  approvalPattern String?
  
  approvalCommentRequired Boolean @default(false)

  rejectionCommentRequired Boolean @default(true)

  approvers ApprovalMatrixApprover[]

  rules WorkflowRule[]

  escalations WorkflowEscalation[]
  claims Claim[]

  @@index([workflowName])
}

model WorkflowRule {
  id Int @id @default(autoincrement())

  approvalMatrixId Int

  field    String
  operator String
  value    String

  approverRole   String?
  approverUserId Int?

  conditionGroup String?

  approvalMatrix ApprovalMatrix @relation(fields: [approvalMatrixId], references: [id], onDelete: Cascade)

  @@index([approvalMatrixId])
}

model WorkflowEscalation {
  id Int @id @default(autoincrement())

  approvalMatrixId Int

  afterHours Int

  action String

  targetDesignationId Int

  isExecuted Boolean @default(false)

  executedAt DateTime?
  approvalMatrix ApprovalMatrix @relation(fields: [approvalMatrixId], references: [id], onDelete: Cascade)

  @@index([approvalMatrixId])
}

model ApprovalMatrixApprover {
  id               Int            @id @default(autoincrement())
  approvalMatrixId Int
  roleId           Int? 
  specificUserId   Int? 
  sequence         Int
  approvalMatrix   ApprovalMatrix @relation(fields: [approvalMatrixId], references: [id], onDelete: Cascade)
  role             Role?          @relation(fields: [roleId], references: [id])
  specificUser     User?          @relation("ApprovalMatrixSpecificUser", fields: [specificUserId], references: [id])
  isParallel Boolean @default(false)
  groupKey String?
  @@index([approvalMatrixId, sequence])
}
enum WorkflowStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}
model User {
  id                   Int                      @id @default(autoincrement())
  name                 String
  email                String                   @unique
  password             String
  departmentId         Int?
  jobTitleId           Int?
  approvalLimit        Decimal?                 @db.Decimal(18, 2)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  designationId        Int?
  reportsToId          Int?
  orgSyncedAt          DateTime?
  claimApprovalHistory ClaimApprovalHistory[]
  claimApprovalActions ClaimApproval[]          @relation("ClaimApprovalActor")
  approvalMatrixSteps  ApprovalMatrixApprover[] @relation("ApprovalMatrixSpecificUser") // NEW
isDepartmentHead Boolean @default(false)
  department    Department?    @relation(fields: [departmentId], references: [id])
  designation   Designation?   @relation(fields: [designationId], references: [id])
  jobTitle      JobTitle?      @relation(fields: [jobTitleId], references: [id])
  reportsTo     User?          @relation("ManagerEmployee", fields: [reportsToId], references: [id])
  subordinates  User[]         @relation("ManagerEmployee")
  notifications Notification[]

  userRoles           UserRole[] @relation("UserRoleUser")
  assignedRoleRecords UserRole[] @relation("UserRoleAssignedBy")

  createdClaims     Claim[] @relation("ClaimCreator")
  reviewedClaims    Claim[] @relation("ClaimReviewer")
  approvedClaims    Claim[] @relation("ClaimApprover")
  assignedApprovals Claim[] @relation("ClaimAssignedApprover")

  uploadedDocuments   ClaimDocument[]
  claimInvestigations ClaimInvestigation[]

  auditLogs   AuditLog[]
  simulations AccessSimulation[]

  submittedTransitions WorkflowTransition[]      @relation("TransitionSubmitter")
  reviewedTransitions  WorkflowTransition[]      @relation("TransitionReviewer")
  approvedTransitions  WorkflowTransition[]      @relation("TransitionApprover")
  transitionEvents     WorkflowTransitionEvent[]

  @@index([departmentId])
  @@index([designationId])
  @@index([jobTitleId])
  @@index([reportsToId])
  @@map("user")
}

model ClaimDocument {
  id             Int      @id @default(autoincrement())
  claimId        Int
  originalName   String
  fileName       String
  mimeType       String
  filePath       String
  size           Int
  uploadedById   Int
  createdAt      DateTime @default(now())
  claim          Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  uploadedBy     User     @relation(fields: [uploadedById], references: [id])
  documentTypeId String?

  @@index([claimId])
  @@index([uploadedById])
  @@map("claimdocument")
}

model ClaimInvestigation {
  id             Int       @id @default(autoincrement())
  claimId        Int
  investigatorId Int
  status         String
  findings       String?
  startedAt      DateTime?
  completedAt    DateTime?
  claim          Claim     @relation(fields: [claimId], references: [id], onDelete: Cascade)
  investigator   User      @relation(fields: [investigatorId], references: [id])

  @@index([claimId])
  @@index([investigatorId])
  @@map("claiminvestigation")
}

model ClaimType {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  schema    Json
  isActive  Boolean  @default(true)
  bypassApprovalChain Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  claims    Claim[]

  @@map("claimtype")
}

model Designation {
  id                   Int      @id @default(autoincrement())
  name                 String   @unique
  defaultApprovalLimit Decimal? @db.Decimal(18, 2)
  users                User[]

  @@map("designation")
}

model EntraGroupRoleMapping {
  id      Int    @id @default(autoincrement())
  groupId String
  roleId  Int
  role    Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([groupId, roleId])
  @@index([roleId])
  @@map("entragrouprolemapping")
}

model JobTitle {
  id            Int      @id @default(autoincrement())
  title         String
  approvalLimit Decimal?
  users         User[]

  @@map("jobtitle")
}

model Permission {
  id              Int              @id @default(autoincrement())
  key             String           @unique
  label           String
  module          String
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]

  @@map("permission")
}

model Role {
  id                      Int                      @id @default(autoincrement())
  name                    String                   @unique
  description             String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  approvalMatrixApprovers ApprovalMatrixApprover[]
  entraGroupMappings      EntraGroupRoleMapping[]
  roleConditions          RoleCondition[]
  rolePermissions         RolePermission[]
  userRoles               UserRole[]
  claimApprovals          ClaimApproval[]

  @@map("role")
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("rolepermission")
}

model UserRole {
  id         Int      @id @default(autoincrement())
  userId     Int
  roleId     Int
  assignedOn DateTime @default(now())
  assignedBy Int?

  user           User  @relation("UserRoleUser", fields: [userId], references: [id], onDelete: Cascade)
  role           Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedByUser User? @relation("UserRoleAssignedBy", fields: [assignedBy], references: [id])

  @@unique([userId, roleId])
  @@index([assignedBy])
  @@index([roleId])
  @@map("userrole")
}

model WorkflowTransition {
  id          String   @id
  title       String
  status      String
  submitterId Int?
  reviewerId  Int?
  approverId  Int?
  createdAt   DateTime @default(now())

  submitter User?                     @relation("TransitionSubmitter", fields: [submitterId], references: [id])
  reviewer  User?                     @relation("TransitionReviewer", fields: [reviewerId], references: [id])
  approver  User?                     @relation("TransitionApprover", fields: [approverId], references: [id])
  events    WorkflowTransitionEvent[]

  @@index([approverId])
  @@index([reviewerId])
  @@index([submitterId])
  @@map("workflowtransition")
}

model WorkflowTransitionEvent {
  id Int @id @default(autoincrement())

  transitionId String

  role String

  actorId Int?

  actorName String

  action String?

  comment String?

  slaBreach Boolean @default(false)

  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  transition WorkflowTransition @relation(fields: [transitionId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@index([transitionId])
  @@map("workflowtransitionevent")
}
